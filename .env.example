# Notion Integration Token (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_your_notion_integration_token_here

# Parent Notion Page ID where setup will scaffold databases (found in page URL)
NOTION_PARENT_PAGE_ID=your_parent_page_id_here

# Notion Database IDs (automatically populated after running npm run setup-notion)
NOTION_BOOKS_DATABASE_ID=
NOTION_HIGHLIGHTS_DATABASE_ID=

# Amazon Domain Configuration (e.g. amazon.com, amazon.co.uk, amazon.de, amazon.co.jp)
AMAZON_DOMAIN=amazon.com

# Amazon Session Cookies String (generated using npm run login)
AMAZON_COOKIE=

# Goodreads User ID for reading shelves and ratings sync (optional)
GOODREADS_USER_ID=
